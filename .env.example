# Variáveis que este painel EXIGE. Sem elas ele não abre e não consulta —
# nenhuma tem valor de reserva escrito no código, e isso é de propósito:
# fallback no fonte faz rotação de chave não rotacionar nada.

# --- A porta do painel (middleware, Basic Auth) -----------------------------
# Sem as duas, TODA rota responde 503 com o nome do que falta. É o desenho:
# uma porta que só existe no código e não no ar seria pior que porta nenhuma.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Supabase do FUNIL de cadastro (service role) ---------------------------
# Projeto do funil — NÃO é o de assinaturas.
FUNNEL_SUPABASE_URL=
FUNNEL_SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase de ASSINATURAS (service role) ---------------------------------
# Faturas, assinaturas e os experimentos de preço.
SUBS_SUPABASE_URL=
SUBS_SUPABASE_SERVICE_ROLE_KEY=

# --- Metabase (ponte para o Postgres de produção) ---------------------------
# A URL tem padrão no código porque é endereço público; a chave não tem.
METABASE_URL=
METABASE_API_KEY=

# --- Ponte de WhatsApp ------------------------------------------------------
# Confere o Authorization de /api/whatsapp/*, que é público para o middleware
# justamente porque tem porta própria.
WHATSAPP_BRIDGE_TOKEN=
